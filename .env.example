# =============================================================================
# KELO WEB — environment (EXAMPLE). Copy to `.env.local`, fill real values.
# NEVER commit `.env.local`. Client can read ONLY NEXT_PUBLIC_* — everything
# else is server-only and must never be exposed to the browser.
# =============================================================================

# --- Supabase (real cloud backend) ---
# URL + anon key are client-safe (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key is SERVER-ONLY. Used by server actions/routes for PIN auth
# and privileged writes. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Session signing (server-only). Generate: `openssl rand -base64 48` ---
SESSION_SECRET=replace-with-a-generated-random-secret

# --- Google OAuth (Drive connect only; NOT app login) ---
# Client id is public; the SECRET is server-only (used in the token exchange).
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# Must match an Authorized redirect URI in Google Cloud, e.g.
# http://localhost:3000/api/drive/callback  (and your prod URL)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/drive/callback

# --- AI providers for LECTURE ANALYSIS ONLY (title/summary/concepts/revision).
# ALL server-only. Configure at least one; the router falls back. None of
# these are ever used for transcription — see ASSEMBLYAI/GROQ below. ---
GEMINI_API_KEY=your-gemini-api-key
GROK_API_KEY=your-grok-api-key
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional per-provider model overrides
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
GROK_MODEL=grok-2-latest
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct

# --- Transcription providers (SERVER-ONLY, separate from AI analysis above).
# AssemblyAI is primary; Groq Whisper is the fallback. Configure at least one. ---
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=whisper-large-v3

# --- Resend (SERVER-ONLY). Delivers PIN-recovery emails only — never used for
# login, signup, or any other flow. Get a key at https://resend.com/api-keys ---
RESEND_API_KEY=your-resend-api-key
# Must be a verified sender/domain in your Resend account.
RESEND_FROM_EMAIL="KELO <onboarding@resend.dev>"
